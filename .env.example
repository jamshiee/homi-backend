# App
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=homi_holdings

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

# Admin — comma-separated E.164 format
ADMIN_NUMBERS=

# OTP
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=3

# WhatsApp provider (placeholder — swap when vendor decided)
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAME=otp_verification

# MSG91 SMS fallback
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=HOMIHD

# Storage (placeholder — swap with S3/R2/Supabase when decided)
STORAGE_BASE_URL=http://localhost:3000/uploads
MAX_FILE_SIZE_BYTES=10485760

# CORS (production)
ALLOWED_ORIGINS=
